{
  "name": "nobles-credit-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server/start.ts",
    "start": "node --env-file-if-exists=.env src/server/start.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-24.3.0.tgz",
    "@types/pg": "https://registry.npmjs.org/@types/pg/-/pg-8.15.5.tgz",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"
  }
}
